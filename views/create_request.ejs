<%- include('header', { title: "Создать заявку" }) %>

<div class="row justify-content-center">
    <div class="col-md-8 col-12">
        <h1 class="mb-4">Новая заявка</h1>
        <% if (typeof errors !== 'undefined' && errors.length) { %>
            <div class="alert alert-danger">
                <% errors.forEach(e => { %>
                    <div><%= e %></div>
                <% }) %>
            </div>
        <% } %>
        <form action="/create" method="post">
            <div class="mb-3">
                <label for="room_id" class="form-label">Помещение</label>
                <select name="room_id" id="room_id" class="form-select" required>
                    <option value="" disabled selected>Выберите помещение</option>
                    <% rooms.forEach(r => { %>
                        <option value="<%= r.id %>"><%= r.type %> - <%= r.name %> (<%= r.capacity %> чел) <%= r.id %></option>
                        <!--console.log(r)-->
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="date_start" class="form-label">Дата начала конференции</label>
                <input type="date" class="form-control date_start" name="date_start" id="date_start" required>
            </div>

            <div class="mb-3">
                <label for="payment" class="form-label">
                    <select name="payment" id="form-select" class="form-select" required>
                        <option value="" disabled selected>Выберите способ оплаты</option>
                        <option value="При очном посещении">При очном посещении</option>
                        <option value="Перевод по СБП">Перевод по СБП</option>
                    </select>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Отправить заявку</button>
        </form>

        <p class="mt-3 text-center">
            <a href="/dashboard"><- Вернуться к моим заявкам</a>
        </p>
    </div>
</div>

<%- include('footer') %>