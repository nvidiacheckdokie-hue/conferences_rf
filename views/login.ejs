<%- include('header', { title: "Логин" }) %>

<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-8 col-lg-5" style="max-width: 500px;">
    
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h2 class="h4 card-title text-center mb-4">Вход в систему</h2>

        <% if (errors && errors.length) { %>
          <div class="alert alert-danger" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(e=> { %>
                <li>
                  <%= e %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/login">
          <div class="mb-3">
            <label for="loginInput" class="form-label text-muted small fw-medium">Логин</label>
            <input type="text" id="loginInput" name="login" class="form-control" placeholder="Введите логин" required>
          </div>

          <div class="mb-4">
            <label for="passwordInput" class="form-label text-muted small fw-medium">Пароль</label>
            <input type="password" id="passwordInput" name="password" class="form-control" placeholder="Введите пароль" required>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-medium">Войти</button>
        </form>
      </div>
    </div>

  </div>
</div>

<%- include('footer') %>
