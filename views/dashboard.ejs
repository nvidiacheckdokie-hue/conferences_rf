<%- include('header', { title: "Личный кабинет" }) %>

<div class="row g-4">
<div class="col-12">
    <div class="card shadow-sm p-4 bg-white rounded border-0 border-start border-primary border-4">
        <h5 class="h5 mb-2 text-dark fw-semibold">Информация о пользователе</h5>
        <p class="text-secondary mb-0">
            Добро пожаловать, <strong class="text-dark fw-bold">
                <%= session.fio %>
            </strong>!
        </p>
    </div>
</div>

<div class="col-12">
    <div class="card shadow-sm p-4 bg-white rounded">
        <h5 class="h5 mb-4 text-dark fw-semibold">Список ваших заявок</h5>

        <% if (requests && requests.length> 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <!-- <th scope="col" class="py-3">#</th>
                            <th scope="col" class="py-3">Помещение / Аудитория</th>
                            <th scope="col" class="py-3">Статус заявки</th> -->
                            <!-- <p>Добро пожаловать,<%= typeof login !== 'undefined' ? login : 'Гость' %>!</p> -->

                            <div class="container mb-3">
                                <div>
                                    <div class="mb-3">
                                        <h5>Информация о пользователе</h5>
                                        <% if (session.fio !== null) { %>
                                            <p>
                                                Имя: <strong>
                                                    <%= session.fio %>
                                                </strong>
                                            </p>
                                        <% }
                                        else { %>
                                            <p>
                                                Роль: <strong>
                                                    <%= session.fio %>
                                                </strong>!
                                            </p>
                                        <% } %>
                                    </div>
                                </div>

                                <div>
                                    <div>
                                        <h5>Список заявок</h5>
                                        <% if (requests && requests.length > 0) { %>
                                            <table>
                                                <thead>
                                                    <tr>
                                                        <th scope="col" class="text-center">#</th>
                                                        <th scope="col" class="text-center">Помещение / Аудитория</th>
                                                        <th scope="col" class="text-center">Статус заявки</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% requests.forEach((request, index)=> { %>
                                                        <tr>
                                                            <th scope="row" class="text-center fw-semibold text-secondary">
                                                                <%= index + 1 %>
                                                            </th>
                                                            <td class="fw-medium text-dark text-center">
                                                                <%= request.room_id %>
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (request.status==='Одобрено' ||
                                                                    request.status==='Подтверждено' ) { %>
                                                                    <span
                                                                        class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                                        <%= request.status %>
                                                                    </span>
                                                                <% } else if (request.status==='В обработке'
                                                                    || request.status==='Ожидание' ) { %>
                                                                    <span
                                                                        class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">
                                                                        <%= request.status %>
                                                                    </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
                                                                        <%= request.status %>
                                                                    </span>
                                                                <% } %>
                                                            <!-- <th scope="row">
                                                                <%= index + 1 %>
                                                            </th>
                                                            <td>
                                                                <%= request.room_name %>
                                                            </td>
                                                            <td>
                                                                <span>
                                                                    <%= request.status %>
                                                                </span> -->
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-4">
                                            <p class="text-muted mb-0 fs-5">Активных заявок нет.</p>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                        </tr>
                    </thead>
                </table>
            </div>
        <% } %>
    </div>
</div>

<%- include('footer') %>