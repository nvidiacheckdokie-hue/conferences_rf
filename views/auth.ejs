<%- include('header', { title: "Авторизация" }) %>

<% 
// Жестко определяем режим, никакой неопределенности
var currentMode = (typeof mode !== 'undefined' && mode === 'register') ? 'register' : 'login'; 
%>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm p-4 bg-white rounded">
            <div class="card-body p-0 mb-3">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link <%= currentMode === 'register' ? 'active fw-bold' : '' %>" href="/register">
                            Регистрация
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentMode === 'login' ? 'active fw-bold' : '' %>" href="/login">
                            Вход
                        </a>
                    </li>
                </ul>
            </div>

            <div class="tab-content">
                <% if (currentMode === 'register') { %>
                    <div class="tab-pane fade show active">
                        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                            <div class="alert alert-danger">
                                <ul class="mb-0 small">
                                    <% errors.forEach(e => { %>
                                        <li><%= e %></li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>
                        
                        <form method="POST" action="/register">
                            <div class="mb-3">
                                <label for="reg-login" class="form-label text-secondary small">Логин</label>
                                <input id="reg-login" name="login" class="form-control" placeholder="Придумайте логин" required autocomplete="username"
                                value="<%= typeof form !== 'undefined' ? (form.login || '') : '' %>">
                            </div>

                            <div class="mb-3">
                                <label for="reg-password" class="form-label text-secondary small">Пароль</label>
                                <input id="reg-password" name="password" type="password" class="form-control" placeholder="••••••••" required autocomplete="new-password">
                            </div>

                            <div class="mb-3">
                                <label for="fio" class="form-label text-secondary small">ФИО</label>
                                <input id="fio" name="fio" class="form-control" placeholder="Иванов Иван Иванович" required
                                value="<%= typeof form !== 'undefined' ? (form.fio || '') : '' %>">
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label text-secondary small">Номер телефона</label>
                                <input id="phone" name="phone" type="tel" class="form-control" placeholder="8(999)000-00-00" required
                                value="<%= typeof form !== 'undefined' ? (form.phone || '') : '' %>">
                            </div>

                            <div class="mb-4">
                                <label for="email" class="form-label text-secondary small">Email</label>
                                <input id="email" name="email" type="email" class="form-control" placeholder="example@mail.ru" required
                                value="<%= typeof form !== 'undefined' ? (form.email || '') : '' %>">
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-medium">Создать пользователя</button>
                        </form>

                        <p class="mt-3 text-center small text-muted">
                            Уже есть аккаунт? <a href="/login" class="text-decoration-none">Войти</a>
                        </p>
                    </div>
                <% } else { %>
                    <div class="tab-pane fade show active">
                        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                            <div class="alert alert-danger small">
                                <%= errors[0] %>
                            </div>
                        <% } %>
                        
                        <form method="POST" action="/login">
                            <div class="mb-3">
                                <label class="form-label text-secondary small" for="auth-login">Логин</label>
                                <input id="auth-login" name="login" class="form-control" placeholder="Введите логин" required autocomplete="username"
                                value="<%= typeof form !== 'undefined' ? (form.login || '') : '' %>">
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-secondary small" for="auth-password">Пароль</label>
                                <input id="auth-password" name="password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-medium">Авторизоваться</button>
                        </form>

                        <p class="text-center mt-3 small text-muted">
                            Ещё не зарегистрированы? <a href="/register" class="text-decoration-none">Регистрация</a>
                        </p>

                        <p class="text-center mt-3 small text-muted">
                            <a href="/restore" class="text-decoration-none">Восстановить пароль</a>
                        </p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
